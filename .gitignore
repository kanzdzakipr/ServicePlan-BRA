# ============================================================================
# GITIGNORE CONFIGURATION - SERVICEPLAN-BRA (PT BINA REKAYASA ANUGRAH)
# Security & Deprecated File Filtering Rules
# ============================================================================

# 1. Confidential & Legacy Materials (Prevent Public Exposure)
# material/
# raw-material/
arsip/
data.json

# 2. Environment & Database Configuration Credentials
.env
.env.*
config/database.local.php
config/constants.local.php

# 3. Server SQL Dumps & Database Schemas (Aktifkan sementara folder scripts)
# *.sql
# scripts/schema.sql
# schema.sql
!scripts/

# 4. Storage & Dynamic Uploads
uploads/*
!uploads/.gitkeep
logs/*.log

# 5. IDE, Editors & OS System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 6. Temporary Scratch Scripts & IDE Brain Logs
brain/
scratch/
.gemini/

# Eksklusi Mutlak Pemindaian AI Antigravity
# scripts/vendor/
# tests/fixtures/ # (Jika folder testing memiliki sampel payload dokumen berukuran besar)
