# Copy these names into the hosting control panel, Apache SetEnv, PHP-FPM pool,
# container secret configuration, or another server-side secret manager.
# This repository intentionally does not load .env files by itself.

APP_ENV=production
APP_ORIGIN=https://fleet.example.com
APP_ALLOWED_ORIGINS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=serviceplan_bra
DB_USER=serviceplan_app
DB_PASSWORD=replace-in-secret-manager
ARCHIVE_DB_NAME=asset_manager

SESSION_NAME=BRASESSID
ARCHIVE_SESSION_NAME=BRAARCHIVESESSID
SESSION_SAVE_PATH=/secure/writable/php-sessions
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
