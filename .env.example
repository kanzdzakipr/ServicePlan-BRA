# ==============================================================================
# ServicePlan-BRA - Environment Configuration Template (.env.example)
# Salin file ini menjadi .env lalu sesuaikan dengan lingkungan (Lokal / Production).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & CORS ORIGINS
# ------------------------------------------------------------------------------
# APP_ENV: 'local', 'development', atau 'production'
APP_ENV=local

# APP_ORIGIN: Origin utama aplikasi (tanpa trailing slash)
# Lokal: http://localhost  atau  http://serviceplan-bra.test
# Production: https://darkred-pelican-368049.hostingersite.com
APP_ORIGIN=http://localhost

# APP_ALLOWED_ORIGINS: Daftar origin yang diizinkan dipisahkan koma
# (Wajib menyertakan localhost / 127.0.0.1 jika diuji pada server lokal Laragon)
# Contoh Lokal: http://localhost,http://127.0.0.1,http://serviceplan-bra.test,https://darkred-pelican-368049.hostingersite.com
# Contoh Production: https://darkred-pelican-368049.hostingersite.com
APP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://serviceplan-bra.test

# ALLOW_SEED_PASSWORDS: true jika menggunakan akun/password bawaan (admin123, dsb.) saat testing lokal. Wajib false di production!
ALLOW_SEED_PASSWORDS=true

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# Lokal (Laragon): DB_HOST=127.0.0.1, DB_PORT=3306, DB_NAME=u646470441_ServicePlanBRA, DB_USER=root, DB_PASSWORD=
# Production: DB_HOST=localhost, DB_PORT=3306, DB_NAME=u646470441_ServicePlanBRA, DB_USER=u646470441_ptEClt5jaya, DB_PASSWORD=...
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u646470441_ServicePlanBRA
DB_USER=root
DB_PASSWORD=
ARCHIVE_DB_NAME=u646470441_ServicePlanBRA

# ------------------------------------------------------------------------------
# 3. SESSION MANAGEMENT
# ------------------------------------------------------------------------------
SESSION_NAME=BRASESSID
ARCHIVE_SESSION_NAME=BRAARCHIVESESSID
# SESSION_SAVE_PATH: kosongkan untuk default sistem, atau isi path absolut writable
# SESSION_SAVE_PATH=C:/laragon/tmp/ServicePlan-BRA-sessions
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800

# ------------------------------------------------------------------------------
# 4. UPLOAD STORAGE (Optional)
# ------------------------------------------------------------------------------
# Path direktori penyimpanan upload di luar webroot publik (opsional)
# UPLOAD_STORAGE_PATH=/home/account/serviceplan-private-uploads
