# ============================================================================
# WORK ORDERS UPLOADS SECURITY CONFIGURATION (.htaccess)
# ServicePlan-BRA (PT Bina Rekayasa Anugrah Equipment System)
# ============================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Block all executable script formats
<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml|asp|aspx|jsp|exe|dll|bat|cmd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Prevent MIME type sniffing
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# 4. Turn off PHP execution engine if mod_php is active
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
