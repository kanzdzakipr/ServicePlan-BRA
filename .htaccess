# ============================================================================
# APACHE SECURITY & REWRITE CONFIGURATION (.htaccess)
# ServicePlan-BRA (PT Bina Rekayasa Anugrah Equipment System)
# ============================================================================

# 1. Disable Directory Browsing Globally
Options -Indexes

# 2. Set Default Index Page
DirectoryIndex index.html dashboard.php index.php

# 3. Security Headers (Harden Browser Protection)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Deny Direct Web Access to Sensitive Directories
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Legacy dashboard URL must pass through the server-side session guard.
    RewriteRule ^dashboard\.html$ /ServicePlan-BRA/dashboard.php [R=302,L,NE]

    # The full dashboard view may only be included by dashboard.php.
    RewriteRule ^dashboard\.view\.php$ - [F,L,NC]

    # Data sources and repository metadata are never public web assets.
    RewriteRule ^(?:data\.json|\.git(?:/|$)|material(?:/|$)|raw-material(?:/|$)) - [F,L,NC]

    # Internal API bootstrap files cannot be invoked as controllers.
    RewriteRule ^api/(?:db|security)\.php$ - [F,L,NC]

    # Deprecated applications, private storage, tests, and maintenance utilities are never public.
    RewriteRule ^archive/(?:dashboard|login|logout)\.php$ - [L,NC]
    RewriteRule ^archive/assets(?:/|$) - [L,NC]
    RewriteRule ^(?:archive|arsip|storage|tests)(?:/|$) - [F,L,NC]
    RewriteRule ^scripts/.*\.(?:php|ps1|sql|bat|cmd|sh|md|json)$ - [F,L,NC]

    # Block access to core backend PHP class folders & internal configs
    RewriteRule ^(core|config|models)/ - [F,L]
</IfModule>

# 5. Deny Direct Web Access to Sensitive Credentials & SQL Schemas
<FilesMatch "(^\.env(?:\..*)?$|\.(?:sql|log|git|gitignore|htaccess|ini|sh|phps|ps1|bat|cmd|md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 6. Character Encoding Enforcement
AddDefaultCharset UTF-8
