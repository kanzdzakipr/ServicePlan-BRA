# ============================================================================
# APACHE SECURITY & REWRITE CONFIGURATION (.htaccess)
# ServicePlan-BRA (PT Bina Rekayasa Anugrah Equipment System)
# ============================================================================

# 1. Disable Directory Browsing Globally
Options -Indexes

# 2. Set Default Index Page
DirectoryIndex dashboard.html index.html index.php

# 3. Security Headers (Harden Browser Protection)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Deny Direct Web Access to Sensitive Directories
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to confidential material, raw-material, and arsip folders
    RewriteRule ^(material|raw-material|arsip)/ - [F,L]

    # Block access to core backend PHP class folders & internal configs
    RewriteRule ^(core|config|models)/ - [F,L]
</IfModule>

# 5. Deny Direct Web Access to Sensitive Files & Data Sources
<FilesMatch "\.(env|json|sql|log|md|git|gitignore|htaccess|ini|sh|phps)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Explicitly Block Public Access to data.json & schema.sql
<Files "data.json">
    Require all denied
</Files>

<Files "schema.sql">
    Require all denied
</Files>

# 6. Character Encoding Enforcement
AddDefaultCharset UTF-8
